# =============================================================
# JASMA COLLECTIONS â€” Environment Variables Template
# Copy this to .env in the root AND each app that needs it
# =============================================================

# ---- DATABASE (packages/db + apps/api) ----
DATABASE_URL="postgresql://jasma_user:jasma_pass@localhost:5432/jasma_db"

# ---- API (apps/api) ----
PORT=4000
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000"

# ---- NEXT.JS (apps/web) ----
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"

# ---- CLOUDINARY ----
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ---- M-PESA DARAJA API ----
MPESA_CONSUMER_KEY="your-consumer-key"
MPESA_CONSUMER_SECRET="your-consumer-secret"
MPESA_PASSKEY="your-passkey"
MPESA_SHORTCODE="174379"
MPESA_CALLBACK_URL="https://your-api-domain.railway.app/api/mpesa/callback"
MPESA_ENV="sandbox"

# ---- EMAIL (Resend) ----
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Jasma Collections <no-reply@jasma.co.ke>"
